{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Jointl Developer Documentation",
  "description": "Build secure integrations with the Jointl REST API, OAuth, MCP, Zapier, and Greenhouse.",
  "colors": {
    "primary": "#0B8190",
    "light": "#0B8190",
    "dark": "#3FDAED"
  },
  "favicon": "/assets/favicon.svg",
  "logo": {
    "light": "/assets/logo.svg",
    "dark": "/assets/logo-dark.svg",
    "href": "https://docs.join.tl"
  },
  "navbar": {
    "links": [
      {
        "label": "Jointl",
        "href": "https://join.tl"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Jointl",
      "href": "https://join.tl/login"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Getting started",
            "pages": [
              "getting-started/index",
              "getting-started/choose-access",
              "getting-started/first-api-call"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/authentication",
              "concepts/permissions",
              "concepts/errors-retries",
              "concepts/pagination-idempotency",
              "concepts/safe-writes",
              "concepts/standards",
              "concepts/versioning"
            ]
          },
          {
            "group": "REST API",
            "pages": [
              "rest-api/index",
              "rest-api/http-endpoints",
              "rest-api/operations"
            ]
          },
          {
            "group": "Jointl MCP",
            "pages": [
              "jointl-mcp/index",
              "jointl-mcp/reference"
            ]
          },
          {
            "group": "Updates",
            "pages": [
              "changelog/index",
              "changelog/2026-09-06",
              "changelog/2026-09-04",
              "changelog/v1.0.0"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "code",
        "groups": [
          {
            "group": "Jointl REST API and OAuth",
            "openapi": "specs/openapi/jointl-api-v1.openapi.yaml",
            "pages": [
              {
                "group": "OAuth",
                "pages": [
                  "GET /oauth/authorize",
                  "POST /oauth/token",
                  "POST /oauth/revoke",
                  "GET /oauth/jwks",
                  "GET /oauth/userinfo"
                ]
              },
              {
                "group": "Discovery",
                "pages": [
                  "GET /.well-known/oauth-authorization-server/oauth",
                  "GET /.well-known/openid-configuration/oauth",
                  "GET /.well-known/oauth-protected-resource/api/v1"
                ]
              },
              {
                "group": "Read operations",
                "pages": [
                  "GET /api/v1/operations",
                  "POST /api/v1/operations/{operationId}",
                  "POST /api/v1/operations/workspace.get",
                  "POST /api/v1/operations/workspace.search",
                  "POST /api/v1/operations/companies.list",
                  "POST /api/v1/operations/flows.list",
                  "POST /api/v1/operations/flows.get",
                  "POST /api/v1/operations/flows.capabilities.get",
                  "POST /api/v1/operations/flows.templates.list",
                  "POST /api/v1/operations/flows.questions.search",
                  "POST /api/v1/operations/flows.referenceTemplates.list",
                  "POST /api/v1/operations/flows.blueprint.get",
                  "POST /api/v1/operations/performance.operations.get",
                  "POST /api/v1/operations/checks.list",
                  "POST /api/v1/operations/checks.analytics",
                  "POST /api/v1/operations/checks.get",
                  "POST /api/v1/operations/checks.report",
                  "POST /api/v1/operations/references.list",
                  "POST /api/v1/operations/references.get",
                  "POST /api/v1/operations/employees.list",
                  "POST /api/v1/operations/employees.analytics",
                  "POST /api/v1/operations/employees.get",
                  "POST /api/v1/operations/talents.list",
                  "POST /api/v1/operations/talents.get",
                  "POST /api/v1/operations/talents.references.list",
                  "POST /api/v1/operations/autopilots.list",
                  "POST /api/v1/operations/autopilots.get",
                  "POST /api/v1/operations/insights.get"
                ]
              },
              {
                "group": "Protected actions",
                "pages": [
                  "POST /api/v1/actions/prepare",
                  "POST /api/v1/actions/confirm"
                ]
              }
            ]
          },
          {
            "group": "App-bound endpoints",
            "pages": [
              {
                "group": "Zapier app endpoints",
                "openapi": "specs/openapi/jointl-api-v1.openapi.yaml",
                "pages": [
                  "POST /api/v1/operations/checks.verifications.get",
                  "POST /api/v1/operations/checks.publicProfiles.get",
                  "POST /api/v1/operations/employees.exitIntelligence.get",
                  "POST /api/v1/operations/events.list",
                  "POST /api/v1/operations/events.get",
                  "POST /api/v1/actions/execute",
                  "POST /api/v1/webhook-subscriptions",
                  "DELETE /api/v1/webhook-subscriptions/{id}"
                ]
              },
              {
                "group": "Greenhouse app endpoints",
                "openapi": "specs/openapi/greenhouse-v1.openapi.yaml",
                "pages": [
                  "rest-api/greenhouse-app-endpoints",
                  {
                    "group": "Webhook delivery",
                    "pages": [
                      "POST /api/apps/greenhouse/v1/webhook/{installationId}"
                    ]
                  },
                  {
                    "group": "Assessment API",
                    "pages": [
                      "GET /api/apps/greenhouse/v1/assessment/list_tests",
                      "POST /api/apps/greenhouse/v1/assessment/send_test",
                      "GET /api/apps/greenhouse/v1/assessment/test_status",
                      "POST /api/apps/greenhouse/v1/assessment/response_error"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "group": "Event and webhook contracts",
            "pages": [
              "rest-api/zapier-webhook-event-delivery"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "icon": "plug",
        "groups": [
          {
            "group": "Zapier",
            "pages": [
              "integrations/zapier/index",
              "integrations/zapier/reference"
            ]
          },
          {
            "group": "Greenhouse",
            "pages": [
              "integrations/greenhouse/index"
            ]
          },
          {
            "group": "AI clients",
            "pages": [
              "integrations/ai-clients/index",
              "integrations/ai-clients/chatgpt",
              "integrations/ai-clients/claude",
              "integrations/ai-clients/codex",
              "integrations/ai-clients/generic-mcp"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "simple",
      "proxy": false,
      "credentials": false
    },
    "url": "full",
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required",
      "prefill": false,
      "autogenerate": true
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "download-spec"
    ],
    "display": "header"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.join.tl",
      "og:site_name": "Jointl Developer Documentation"
    }
  },
  "search": {
    "prompt": "Search Jointl developer docs..."
  },
  "footer": {
    "socials": {
      "github": "https://github.com/jointl"
    }
  }
}
